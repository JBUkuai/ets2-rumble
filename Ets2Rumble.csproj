<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Ets2Rumble</RootNamespace>
    <AssemblyName>Ets2Rumble</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.2.0</Version>
    <Company>localhost</Company>
    <Product>ETS2 Rumble</Product>
    <Description>ETS2 Xbox 手柄震动增强（握把马达）</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="docs\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
